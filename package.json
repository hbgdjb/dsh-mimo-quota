{
  "name": "dsh-mimo-quota",
  "version": "1.1.1",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mimo",
    "quota",
    "usage",
    "tokens",
    "statistics",
    "dsh-bundle"
  ],
  "description": "Realtime model usage panel: tokens, cost, requests, trend and composition",
  "meta": {
    "title": "MIMO Quota Panel",
    "description": "Realtime model usage panel: tokens, cost, requests, trend and composition"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hbgdjb/dsh-mimo-quota.git"
  },
  "homepage": "https://github.com/hbgdjb/dsh-mimo-quota",
  "bugs": {
    "url": "https://github.com/hbgdjb/dsh-mimo-quota/issues"
  }
}